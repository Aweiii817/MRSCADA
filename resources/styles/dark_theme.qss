/* ============================================================
   UCS 浅灰主题样式表
   ============================================================ */

/* 主窗口背景 */
QMainWindow { background-color: #F0F0F0; }

/* 菜单栏 */
QMenuBar {
    background-color: #B0B0B0;
    color: #2C3E50;
    padding: 2px 5px;
    font-size: 13px;
}
QMenuBar::item:selected {
    background-color: #4A90D9;
    color: #FFFFFF;
}

/* 下拉菜单 */
QMenu {
    background-color: #FFFFFF;
    color: #2C3E50;
    border: 1px solid #CCCCCC;
}
QMenu::item:selected {
    background-color: #4A90D9;
    color: #FFFFFF;
}

/* 状态栏 */
QStatusBar {
    background-color: #E6E6E6;
    color: #2C3E50;
    font-size: 12px;
    border-top: 1px solid #CCCCCC;
}

/* 按钮 */
QPushButton {
    background-color: #4A90D9;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    min-height: 24px;
}
QPushButton:hover { background-color: #357ABD; }
QPushButton:pressed { background-color: #2A6DA8; }
QPushButton:disabled { background-color: #BDC3C7; color: #ECF0F1; }

/* 输入框 */
QLineEdit {
    background-color: #FFFFFF;
    color: #2C3E50;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}
QLineEdit:focus { border-color: #4A90D9; }

/* 文本标签 */
QLabel { color: #2C3E50; font-size: 13px; }

/* 表格控件 */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F0F0F0;
    color: #2C3E50;
    border: 1px solid #CCCCCC;
    gridline-color: #DDDDDD;
}
QHeaderView::section {
    background-color: #E6E6E6;
    color: #2C3E50;
    padding: 5px;
    border: 1px solid #CCCCCC;
    font-weight: bold;
}

/* 滚动条 */
QScrollBar:vertical {
    background-color: #F0F0F0;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #B0B0B0;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background-color: #909090; }
